{
  "name": "mansah",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --port 8787",
    "dev:client": "vite",
    "dev:server": "wrangler dev --port 8787",
    "build": "tsc -b && vite build && node scripts/build-worker.mjs",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply mansah-local --local",
    "dev:worker": "wrangler dev --port 8787",
    "test": "node --test tests/api.test.mjs",
    "preview": "vite preview",
    "server": "wrangler dev --port 8787"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "peerjs": "^1.5.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "wrangler": "^4.131.1"
  }
}
